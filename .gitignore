# Rust
/target/
**/*.rs.bk
*.pdb
*.dll
*.so
*.dylib
*.rlib
*.rmeta

# Generated code (the transpiled Rust server, and the WASI module phase 5
# writes beside it).
generated/
generated-wasm/

# Local context engine (SQLite + LanceDB), one store per project dir
.rivet/
*.db
*.db-wal
*.db-shm
.lancedb/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
*.lcov
coverage/

# Build artifacts, except the example's committed frontend build: the
# phase-4 asset test renames that directory and proves the binary still
# serves it from memory (pillar 03).
# A frontend's production output. Do not ignore a bare `build/`: that
# pattern also matches `rivet-cli/src/commands/build/`, which holds tracked
# source.
dist/
node_modules/
!examples/basic/dist/
!examples/basic/dist/**
